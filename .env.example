# Sao chép thành .env (chạy trên máy) hoặc khai báo trong mục Environment variables của Hostinger.
# Mọi dòng đều không bắt buộc; để trống thì dùng giá trị mặc định trong src/config.js.
NODE_ENV=production
# PORT do Hostinger tự cấp, chỉ đặt khi chạy trên máy/VPS
# PORT=3000
SITE_URL=https://tananhoi.vn
# SITE_DON_VI=Ủy ban nhân dân xã Tân An Hội
# SITE_NOI_TIEP_NHAN=Trung tâm Phục vụ hành chính công xã Tân An Hội
# SITE_DIA_CHI=Số 77 đường Tỉnh lộ 8, ấp 9, xã Tân An Hội, Thành phố Hồ Chí Minh
# SITE_DIEN_THOAI=028.38920318; đường dây nóng: 0901.404.999, 0932.686.666
# SITE_GIO_LAM_VIEC=Thứ Hai đến Thứ Sáu: ...
# Ảnh thực tế của Trung tâm (đặt ảnh vào public/assets/img/ rồi khai báo, viết trên một dòng):
# SITE_PHOTOS=[{"src":"/assets/img/tru-so.webp","chuThich":"Trụ sở Trung tâm Phục vụ hành chính công"}]
